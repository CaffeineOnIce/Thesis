        <mxCell id="c_data" value="1. Data Layer (one city, many stations)" style="rounded=1;arcSize=3;dashed=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">

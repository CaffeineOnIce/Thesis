        </mxCell>
        <mxCell id="c_pred" value="2. Prediction Layer — pollution.py (River, learns every hour)" style="rounded=1;arcSize=3;dashed=1;fillColor=#f5fbf3;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
